        <Extension Id="com.motionbydk.aeworkflow.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/script.jsxbin</ScriptPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MotionByDk AEworkflow</Menu>
                    <Geometry>
                        <Size>
                            <Height>600</Height>
                            <Width>340</Width>
                        </Size>
                        <MinSize>
                            <Height>350</Height>
                            <Width>280</Width>
                        </MinSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>

